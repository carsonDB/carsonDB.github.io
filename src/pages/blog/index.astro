---
import BaseLayout from "@layouts/BaseLayout.astro";
import PostCard from "@components/PostCard.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Writing" description="All writing by Carson Wu.">
  <section class="container home-intro">
    <div class="intro-copy">
      <p class="eyebrow">Archive</p>
      <h1>All writing.</h1>
      <p>Notes on AI, software, research, and ideas in progress.</p>
    </div>
  </section>

  <section class="container posts-section">
    <div class="section-label">
      <h2>Posts</h2>
      <p>{posts.length} {posts.length === 1 ? "post" : "posts"}</p>
    </div>
    <div class="post-list">
      {posts.map((post, index) => <PostCard post={post} index={index + 1} />)}
    </div>
  </section>
</BaseLayout>
