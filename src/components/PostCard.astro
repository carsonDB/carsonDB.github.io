---
import { getSeriesMeta } from "../lib/series";

const { post } = Astro.props;
const series = getSeriesMeta(post.data.series);
const formattedDate = post.data.date.toLocaleDateString("en", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<article class="post-card">
  <div class="post-meta">
    <time datetime={post.data.date.toISOString()}>{formattedDate}</time>
    <span>{series.label}</span>
  </div>
  <h2><a href={`/blog/${post.slug}/`}>{post.data.title}</a></h2>
  <p>{post.data.description}</p>
  <div class="tag-row" aria-label="Tags">
    {post.data.tags.map((tag) => <span>{tag}</span>)}
  </div>
</article>
