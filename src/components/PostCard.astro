---
const { post, index } = Astro.props;
const formattedDate = post.data.date.toLocaleDateString("en", {
  year: "numeric",
  month: "long",
});
---

<article class="post-row">
  <div class="post-number" aria-hidden="true">
    {String(index).padStart(2, "0")}
  </div>
  <div class="post-summary">
    <div class="post-meta">
      <time datetime={post.data.date.toISOString()}>{formattedDate}</time>
      {post.data.tags.slice(0, 2).map((tag) => <span>{tag}</span>)}
    </div>
    <h3><a href={`/blog/${post.slug}/`}>{post.data.title}</a></h3>
    {post.data.description && <p>{post.data.description}</p>}
  </div>
  <a class="post-arrow" href={`/blog/${post.slug}/`} aria-label={`Read ${post.data.title}`}>
    →
  </a>
</article>
