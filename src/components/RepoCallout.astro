---
const {
  title = "CogCore",
  href = "https://github.com/carsonDB/cogCore",
} = Astro.props;
---

<aside class="repo-callout">
  <div>
    <p class="eyebrow">Open-source project</p>
    <h2>{title}</h2>
    <p>
      A technical writing hub for explaining the design decisions, architecture,
      and engineering tradeoffs behind CogCore.
    </p>
  </div>
  <a class="button" href={href}>View GitHub</a>
</aside>
