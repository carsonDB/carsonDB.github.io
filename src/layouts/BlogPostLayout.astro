---
import BaseLayout from "@layouts/BaseLayout.astro";

const { entry } = Astro.props;
const formattedDate = entry.data.date.toLocaleDateString("en", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article class="article">
    <a class="back-link" href="/">← All writing</a>
    <header class="article-header">
      <p class="eyebrow">Essay</p>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.description}</p>
      <div class="post-meta">
        <time datetime={entry.data.date.toISOString()}>{formattedDate}</time>
        {entry.data.tags.map((tag) => <span>{tag}</span>)}
      </div>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<script>
  const renderMermaid = async () => {
    const diagrams = Array.from(
      document.querySelectorAll<HTMLElement>('pre[data-language="mermaid"]'),
    );

    if (diagrams.length === 0) return;

    const { default: mermaid } = await import("mermaid");

    mermaid.initialize({
      startOnLoad: false,
      theme: "base",
      securityLevel: "strict",
      themeVariables: {
        background: "#f8f5ee",
        primaryColor: "#e8f0fb",
        primaryBorderColor: "#2563a7",
        primaryTextColor: "#1f2933",
        secondaryColor: "#fff0df",
        secondaryBorderColor: "#c76b16",
        tertiaryColor: "#f2efe7",
        lineColor: "#59636e",
        fontFamily: "Inter, ui-sans-serif, system-ui, sans-serif",
      },
      flowchart: {
        curve: "basis",
        htmlLabels: false,
      },
    });

    const nodes = diagrams.map((pre) => {
      const container = document.createElement("div");
      container.className = "mermaid";
      container.textContent = pre.textContent ?? "";
      pre.replaceWith(container);
      return container;
    });

    await mermaid.run({ nodes });
  };

  void renderMermaid();
</script>
