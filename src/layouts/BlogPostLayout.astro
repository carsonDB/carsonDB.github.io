---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getSeriesMeta } from "../lib/series";

const { entry } = Astro.props;
const series = getSeriesMeta(entry.data.series);
const formattedDate = entry.data.date.toLocaleDateString("en", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article class="article">
    <header class="article-header">
      <p class="eyebrow">{series.label}</p>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.description}</p>
      <div class="post-meta">
        <time datetime={entry.data.date.toISOString()}>{formattedDate}</time>
        <span>{series.label}</span>
        {entry.data.tags.map((tag) => <span>{tag}</span>)}
      </div>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
